# Nada nesta pasta é servido diretamente: o conteúdo publicado e as contas
# do painel só são lidos pelo PHP.
#
# As duas sintaxes de propósito: a de baixo é do Apache 2.4, a de cima do
# 2.2. Num servidor 2.4 sem mod_access_compat, "deny from all" sozinho dá
# erro 500 em vez de 403.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  deny from all
</IfModule>
