# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdn.emailjs.com https://www.youtube.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://www.youtube.com https://www.openstreetmap.org; connect-src 'self' https://api.emailjs.com https://nominatim.openstreetmap.org https://graph.facebook.com https://api.allorigins.win https://corsproxy.io https://api.codetabs.com; worker-src 'self'"
</IfModule>

# Prevent directory listing
Options -Indexes

# Block sensitive file types (data JSON, configs, dumps, documentação interna)
#
# O .md entrou nesta lista porque o AUDITORIA.md era servido inteiro — 118 KB
# que nomeiam, ficheiro a ficheiro, cada defeito conhecido do projeto, incluindo
# os que ainda não estavam corrigidos. Um mapa desses não se publica. O
# robots.txt acompanha, mas robots.txt é um pedido, não uma protecção: é esta
# regra que impede o acesso.
#
# As duas sintaxes de propósito, como em data/.htaccess e tools/.htaccess:
# a de cima é do Apache 2.4, a de baixo do 2.2. Sem a segunda, num
# servidor que não anuncie o mod_authz_core — é o caso do LiteSpeed, que
# entende as duas sintaxes mas não aparece com esse módulo na lista — o
# bloco inteiro era ignorado e o data/db.json ficava legível por qualquer
# pessoa. Onde o mod_authz_core existe, a segunda nunca é lida.
<FilesMatch "\.(env|json|log|sql|bak|sh|bat|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
# ...but the PWA manifest must stay public (blocking it breaks the
# service worker install: cache.addAll fails on any 403).
# A excepção tem de existir nas duas sintaxes, senão o manifesto ficava
# bloqueado justamente nos servidores onde a regra de cima não se aplica.
<Files "manifest.json">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
  </IfModule>
</Files>

# A pasta scraper/ é uma ferramenta de linha de comando: importa
# classificações do resultados.fpf.pt e corre no computador de quem publica,
# nunca no browser de quem visita. Não tinha .htaccess, e o fpf-scraper.js e o
# README.md eram servidos e indexáveis.
#
# Aqui basta uma sintaxe: o mod_alias existe em Apache 2.2 e 2.4 e no LiteSpeed,
# ao contrário do mod_authz_core, que é só do 2.4 e obriga ao par de blocos que
# está acima.
<IfModule mod_alias.c>
  RedirectMatch 403 ^/scraper(/.*)?$
</IfModule>

# Impedir indexação fora do domínio oficial (subdomínios de teste,
# pré-visualizações, qualquer host que não seja o site a sério).
#
# Fica no ficheiro versionado de propósito. A decisão é tomada pelo Host,
# não por o ficheiro estar nesta ou naquela pasta, o que evita os dois
# enganos habituais: esquecer o noindex no staging, e arrastar um noindex
# para produção ao copiar o staging por cima.
#
# >> Se o domínio final NÃO for campinense.pt, altere a segunda linha
# >> abaixo, senão o site real deixa de ser indexado. <<
<IfModule mod_setenvif.c>
  SetEnvIf Host "." JSC_NOINDEX=1
  SetEnvIf Host "^(www\.)?campinense\.pt(:[0-9]+)?$" !JSC_NOINDEX
  <IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow" env=JSC_NOINDEX
  </IfModule>
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png  "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css   "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType application/json "access plus 1 day"
</IfModule>

# Um único endereço oficial: https://campinense.pt
# Sem isto o mesmo site responde em quatro endereços (com e sem www,
# em http e https) e o Google trata-os como conteúdos duplicados.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.campinense.pt -> campinense.pt (mantém o esquema)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ %{REQUEST_SCHEME}://%1%{REQUEST_URI} [R=301,L]

  # http -> https
  # >> Só funciona depois de o AutoSSL emitir o certificado. Se o site
  # >> ficar inacessível logo a seguir ao upload, comente as três linhas
  # >> seguintes, corra o AutoSSL no cPanel, e descomente-as. <<
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # ---- Notícia individual servida pelo servidor (E2) ----
  # O noticias.html?id=N passa a ser respondido pelo api/noticia.php, que
  # escreve o artigo, o <head> e os dados estruturados dessa notícia dentro da
  # página já gerada.
  #
  # É uma reescrita INTERNA: sem [R], o endereço público não muda e o visitante
  # continua a ver noticias.html?id=N. Sem isto, só quem tem JavaScript lê uma
  # notícia, e os motores de busca e as partilhas vêem sempre o mesmo título e
  # a mesma descrição, os da lista, em todos os artigos.
  #
  # As três linhas, por ordem:
  #   1. só actua se a query tiver um id só de dígitos. Sem id, ou com um id
  #      que não seja número, a página serve-se como sempre — estática;
  #   2. o ?preview=1 fica de fora. A pré-visualização é o rascunho que o
  #      painel guardou no sessionStorage do próprio browser: não está
  #      publicado, não existe no servidor, e não pode passar a existir;
  #   3. o QSA mantém a query toda, e o [L] fecha a reescrita aqui.
  #
  # O que o api/noticia.php recebe passa a dizer /api/noticia.php no
  # REQUEST_URI. É por isso que o canonical de lá se monta do endereço oficial
  # mais o id, e nunca do REQUEST_URI.
  RewriteCond %{QUERY_STRING} (^|&)id=[0-9]+(&|$)
  RewriteCond %{QUERY_STRING} !(^|&)preview=
  RewriteRule ^noticias\.html$ /api/noticia.php [L,QSA]

  # ---- Rede de segurança para os endereços do antigo site WordPress ----
  # No dia em que o WordPress sair, os endereços que o Google já tem
  # indexados deixam de existir. Sem isto passam todos a erro 404 e o
  # site perde o posicionamento ao longo das semanas seguintes.
  #
  # Estas regras só actuam quando o ficheiro pedido NÃO existe, por isso
  # nunca interferem com as páginas, imagens ou /api do site novo.
  #
  # Isto é uma rede, não um mapa: manda tudo o que era notícia para a
  # página de notícias. Quando houver a lista dos endereços antigos,
  # acrescentar aqui por cima os redirecionamentos página a página, que
  # preservam muito melhor o posicionamento de cada artigo.

  # Notícias, categorias, etiquetas e arquivo -> página de notícias
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(noticias|noticia|category|categoria|tag|blog|arquivo|archives?)(/.*)?$ /noticias.html [R=301,L]

  # Ligações antigas por número de artigo (?p=123)
  RewriteCond %{QUERY_STRING} (^|&)p=[0-9]+
  RewriteRule ^$ /noticias.html? [R=301,L]

  # Restos do WordPress (backoffice, autores, feeds) -> página inicial
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(wp-admin|wp-login\.php|author|feed|comments)(/.*)?$ / [R=301,L]
</IfModule>
# O favicon.ico existe na raiz, com 16, 32 e 48 px lá dentro.
# Antes isto reencaminhava para o logo.png de 512x512.
