# Esta pasta recebe ficheiros enviados pelo painel. Nada aqui pode ser
# executado: se alguém conseguir lá pôr um .php, ele tem de ser servido
# como texto ou recusado, nunca corrido pelo servidor.
#
# O upload.php já valida o conteúdo com getimagesize() e gera ele próprio
# o nome e a extensão, portanto isto é a segunda linha de defesa.

# Desligar o interpretador de PHP (só existe com mod_php)
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php5.c>
  php_flag engine off
</IfModule>

# Tirar os handlers de qualquer linguagem, para o caso de PHP correr por
# CGI/FPM, onde o php_flag acima não tem efeito.
<IfModule mod_mime.c>
  RemoveHandler .php .phar .phtml .php3 .php4 .php5 .php7 .php8 .pl .py .cgi .sh
  RemoveType    .php .phar .phtml .php3 .php4 .php5 .php7 .php8
</IfModule>

# E negar mesmo o acesso a esses ficheiros, se algum lá aparecer.
<FilesMatch "\.(php|phar|phtml|php[0-9]|pl|py|cgi|sh|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI
